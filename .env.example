# Включает модуль команд. false — фразы только печатаются.
COMMANDS_ENABLED=true

# Имя в обращении. Слово запуска можно сказать и можно пропустить: «Эни пуск курсор» и «Эни курсор».
ASSISTANT_NAME=Эни
COMMAND_WAKE=пуск

# Необязательно. По умолчанию data/assistant.db
# ASSISTANT_DB=data/assistant.db

# Тимбенч. Personal access token, в git не входит.
# TEAMBENCH_API_KEY=

# Чат после «имя, поболтаем». Модели лежат в таблице chat_models, не здесь.
# CHAT_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Понимание простой фразы. Локальная модель смысла, без OpenRouter.
# INTENT_MODEL=cointegrated/rubert-tiny2

# Распознавание. Локальная GigaAM v3, rnnt или ctc.
# STT_MODEL=rnnt

# Озвучка. Реплики чата считает локальный Qwen3. «Готово» говорит Милена.
# TTS_PROVIDER=qwen
# TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit
# TTS_VOICE=models/annie-voice.wav
# TTS_ACK_VOICE=Milena
