# Включает модуль команд. false — фразы только печатаются.
COMMANDS_ENABLED=true

# Обращение собирается как «имя» + «слово запуска»: Эни пуск
ASSISTANT_NAME=Эни
COMMAND_WAKE=пуск

# Необязательно. По умолчанию data/assistant.db
# ASSISTANT_DB=data/assistant.db

# Чат после «имя, поболтаем». Модели лежат в таблице chat_models, не здесь.
# CHAT_PROVIDER=openrouter
# OPENROUTER_API_KEY=
